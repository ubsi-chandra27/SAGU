generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU
  WALI_KELAS
  SISWA
  ORANG_TUA
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
  TERLAMBAT
}

enum AssessmentCategory {
  FORMATIF
  SUMATIF
}

enum AssessmentTypeDetail {
  HARIAN
  TUGAS_HARIAN
  KUIS_SINGKAT
  REFLEKSI
  DISKUSI
  TENGAH_SEMESTER
  AKHIR_SEMESTER
  UTS
  UAS
  PROYEK
  PORTOFOLIO
}

enum GradeLetter {
  A
  B
  C
  D
  E
}

enum Predicate {
  SANGAT_BAIK
  BAIK
  CUKUP
  KURANG
  TIDAK_MEMENUHI
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  npsn      String?  @db.VarChar(10)
  address   String   @db.Text
  phone     String?  @db.VarChar(15)
  email     String?  @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  settings Setting?

  @@map("schools")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  key         String   @db.VarChar(100)
  value       String   @db.VarChar(500)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@map("settings")
  @@unique([schoolId, key])
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  username      String  @unique @db.VarChar(50)
  email         String  @unique @db.VarChar(100)
  passwordHash  String  @map("password_hash") @db.VarChar(255)
  role          Role
  avatarUrl     String? @map("avatar_url") @db.VarChar(255)
  isActive      Boolean @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  profile         Profile?
  teacher         Teacher?
  student         Student?
  parents         Parent[]
  attendances     Attendance[]
  auditLogs       AuditLog[]
  homeroomRombels Rombel[]  @relation("HomeroomTeacher")
  summativeAssessments SummativeAssessment[] @relation("PublishedBy")
  teachingJournals     TeachingJournal[]

  @@map("users")
  @@index([username])
  @@index([email])
  @@index([role])
}

model Profile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(255)
  gender          Gender?
  placeOfBirth    String?  @map("place_of_birth") @db.VarChar(100)
  dateOfBirth     DateTime? @map("date_of_birth")
  phone           String?  @db.VarChar(15)
  address         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
  @@unique([userId])
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(20)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  semesters          Semester[]
  classes            Class[]
  teachingAssignments TeachingAssignment[]
  gradingComponents  GradingComponent[]
  rapors             Rapor[]

  @@map("academic_years")
  @@index([name])
}

model Semester {
  id              String   @id @default(uuid()) @db.Uuid
  academicYearId  String   @map("academic_year_id") @db.Uuid
  name            String   @db.VarChar(10)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  academicYear       AcademicYear          @relation(fields: [academicYearId], references: [id])
  classes            Class[]
  rombels            Rombel[]
  teachingAssignments TeachingAssignment[]
  gradingComponents  GradingComponent[]
  rapors             Rapor[]

  @@map("semesters")
  @@unique([academicYearId, name])
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(20)
  level          String   @db.VarChar(10)
  academicYearId String   @map("academic_year_id") @db.Uuid
  capacity       Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id])
  rombels      Rombel[]
  teachingJournals TeachingJournal[]
  rapors       Rapor[]

  @@map("classes")
  @@index([academicYearId, level])
}

model Rombel {
  id                String   @id @default(uuid()) @db.Uuid
  classId           String   @map("class_id") @db.Uuid
  academicYearId    String   @map("academic_year_id") @db.Uuid
  semesterId        String   @map("semester_id") @db.Uuid
  name              String   @db.VarChar(50)
  homeroomTeacherId String?  @map("homeroom_teacher_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  class            Class         @relation(fields: [classId], references: [id])
  academicYear     AcademicYear  @relation(fields: [academicYearId], references: [id])
  semester         Semester      @relation(fields: [semesterId], references: [id])
  homeroomTeacher  User?          @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students         Student[]
  teachingAssignments TeachingAssignment[]
  attendances      Attendance[]
  teachingJournals      TeachingJournal[]
  rapors           Rapor[]

  @@map("rombels")
  @@unique([classId, academicYearId, semesterId, name])
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(10)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  teachingAssignments TeachingAssignment[]
  teachingJournals         TeachingJournal[]
  summativeAssessments SummativeAssessment[]
  rapors              Rapor[]
  learningObjectivesCP LearningObjectiveCP[]

  @@map("subjects")
  @@unique([code])
  @@index([name])
}

model Teacher {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  nip            String?  @db.VarChar(18)
  specialization String?  @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  teachingAssignments TeachingAssignment[]

  @@map("teachers")
  @@unique([userId])
}

model Student {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  nis          String   @db.VarChar(10)
  nisn         String   @db.VarChar(10)
  rombelId     String?  @map("rombel_id") @db.Uuid
  parentName   String?  @map("parent_name") @db.VarChar(255)
  parentPhone  String?  @map("parent_phone") @db.VarChar(15)
  parentEmail  String?  @map("parent_email") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user   User   @relation(fields: [userId], references: [id])
  rombel Rombel? @relation(fields: [rombelId], references: [id])
  attendances      Attendance[]
  formativeAssessments FormativeAssessment[]
  summativeAssessments SummativeAssessment[]
  rapors            Rapor[]

  @@map("students")
  @@unique([nis])
  @@unique([nisn])
  @@index([rombelId])
}

model Parent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  relationship String  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user   User   @relation(fields: [userId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("parents")
  @@unique([userId, studentId])
}

model TeachingAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  teacherId        String   @map("teacher_id") @db.Uuid
  rombelId         String   @map("rombel_id") @db.Uuid
  classId          String   @map("class_id") @db.Uuid
  subjectId        String   @map("subject_id") @db.Uuid
  academicYearId   String   @map("academic_year_id") @db.Uuid
  semesterId       String   @map("semester_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  teacher          Teacher         @relation(fields: [teacherId], references: [id])
  rombel           Rombel          @relation(fields: [rombelId], references: [id])
  class            Class           @relation(fields: [classId], references: [id])
  subject          Subject         @relation(fields: [subjectId], references: [id])
  academicYear     AcademicYear    @relation(fields: [academicYearId], references: [id])
  semester         Semester        @relation(fields: [semesterId], references: [id])
  curriculumModules CurriculumModule[]
  learningObjectives  LearningObjective[]
  meetings            Meeting[]
  formativeAssessments FormativeAssessment[]
  summativeAssessments SummativeAssessment[]
  teachingJournals         TeachingJournal[]
  rapors              Rapor[]
  gradeDashboards     GradeDashboard[]

  @@map("teaching_assignments")
  @@unique([teacherId, rombelId, subjectId, academicYearId, semesterId])
  @@index([teacherId, rombelId])
  @@index([academicYearId, semesterId])
  @@index([subjectId])
}

model LearningObjectiveCP {
  id           String   @id @default(uuid()) @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  gradeLevel   String   @map("grade_level") @db.VarChar(10)
  cpCode    String   @map("cp_code") @db.VarChar(20)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  subject               Subject               @relation(fields: [subjectId], references: [id])
  curriculumModules     CurriculumModule[]

  @@map("learning_objectives_cp")
  @@unique([subjectId, gradeLevel, cpCode])
  @@index([subjectId, gradeLevel])
}

model CurriculumModule {
  id                    String   @id @default(uuid()) @db.Uuid
  teachingAssignmentId String   @map("teaching_assignment_id") @db.Uuid
  cpId                 String?  @map("cp_id") @db.Uuid
  subjectId            String   @map("subject_id") @db.Uuid
  academicYearId       String   @map("academic_year_id") @db.Uuid
  semesterId           String   @map("semester_id") @db.Uuid
  number               Int
  title                String   @db.VarChar(255)
  description          String?  @db.Text
  topics               String?  @db.Text
  assessmentType       String?  @map("assessment_type") @db.VarChar(50)
  weight               Decimal  @db.Decimal(3, 2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  teachingAssignment  TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  cp                  LearningObjectiveCP? @relation(fields: [cpId], references: [id])
  subject             Subject              @relation(fields: [subjectId], references: [id])
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  semester            Semester             @relation(fields: [semesterId], references: [id])
  learningObjectives  LearningObjective[]
  summativeAssessments SummativeAssessment[]
  meetings           Meeting[]

  @@map("curriculum_modules")
  @@unique([teachingAssignmentId, number])
  @@index([teachingAssignmentId])
  @@index([academicYearId, semesterId])
}

model LearningObjective {
  id                    String   @id @default(uuid()) @db.Uuid
  curriculumModuleId   String   @map("curriculum_module_id") @db.Uuid
  teachingAssignmentId String   @map("teaching_assignment_id") @db.Uuid
  subjectId            String   @map("subject_id") @db.Uuid
  academicYearId       String   @map("academic_year_id") @db.Uuid
  semesterId           String   @map("semester_id") @db.Uuid
  tpNumber             Int      @map("tp_number")
  title                String   @db.VarChar(255)
  description          String?  @db.Text
  indicator            String?  @db.Text
  dueDate              DateTime? @map("due_date") @db.Date
  isActive             Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  curriculumModule CurriculumModule @relation(fields: [curriculumModuleId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  subject          Subject          @relation(fields: [subjectId], references: [id])
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  semester         Semester         @relation(fields: [semesterId], references: [id])
  meetings         Meeting[]
  formativeAssessments FormativeAssessment[]

  @@map("learning_objectives")
  @@unique([curriculumModuleId, tpNumber])
  @@index([curriculumModuleId])
  @@index([teachingAssignmentId])
  @@index([academicYearId, semesterId])
}

model Meeting {
  id                     String   @id @default(uuid()) @db.Uuid
  teachingAssignmentId   String   @map("teaching_assignment_id") @db.Uuid
  teachingJournalId      String?  @map("teaching_journal_id") @db.Uuid
  curriculumModuleId     String?  @map("curriculum_module_id") @db.Uuid
  learningObjectiveId    String?  @map("learning_objective_id") @db.Uuid
  meetingNumber          Int      @map("meeting_number")
  meetingDate            DateTime @map("meeting_date") @db.Date
  startTime              DateTime @map("start_time")
  endTime                DateTime @map("end_time")
  topicSummary           String?  @map("topic_summary") @db.Text
  tpCovered              String?  @map("tp_covered") @db.Text
  homeroomTeacherNote   String?  @map("homeroom_teacher_note") @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  teachingAssignment  TeachingAssignment   @relation(fields: [teachingAssignmentId], references: [id])
  teachingJournal     TeachingJournal?     @relation(fields: [teachingJournalId], references: [id])
  curriculumModule    CurriculumModule?    @relation(fields: [curriculumModuleId], references: [id])
  learningObjective   LearningObjective?   @relation(fields: [learningObjectiveId], references: [id])
  formativeAssessments FormativeAssessment[]
  summativeAssessments SummativeAssessment[]

  @@map("meetings")
  @@unique([teachingAssignmentId, meetingNumber])
  @@index([teachingAssignmentId, meetingDate])
}

model Attendance {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  rombelId       String          @map("rombel_id") @db.Uuid
  attendanceDate DateTime        @map("attendance_date") @db.Date
  status         AttendanceStatus
  note           String?         @db.Text
  recordedById   String          @map("recorded_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  student  Student  @relation(fields: [studentId], references: [id])
  rombel   Rombel   @relation(fields: [rombelId], references: [id])
  recorder User     @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@map("attendances")
  @@unique([studentId, attendanceDate])
  @@index([attendanceDate, studentId])
  @@index([rombelId])
}

model TeachingJournal {
  id                    String   @id @default(uuid()) @db.Uuid
  teachingAssignmentId  String   @map("teaching_assignment_id") @db.Uuid
  curriculumModuleId    String?  @map("curriculum_module_id") @db.Uuid
  learningObjectiveId   String?  @map("learning_objective_id") @db.Uuid
  meetingNumber         Int      @map("meeting_number")
  meetingDate           DateTime @map("meeting_date") @db.Date
  startTime             DateTime @map("start_time")
  endTime               DateTime @map("end_time")
  topic                 String   @db.VarChar(255)
  description           String?  @db.Text
  tpCovered             String?  @map("tp_covered") @db.Text
  metodePembelajaran    String?  @map("metode_pembelajaran") @db.VarChar(100)
  media                 String?  @db.Text
  refleksiGuru          String?  @map("refleksi_guru") @db.Text
  tindakLanjut          String?  @map("tindak_lanjut") @db.Text
  isPlan                Boolean  @default(true) @map("is_plan")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  curriculumModule    CurriculumModule?   @relation(fields: [curriculumModuleId], references: [id])
  learningObjective   LearningObjective?  @relation(fields: [learningObjectiveId], references: [id])
  meetings            Meeting[]

  @@map("teaching_journals")
  @@unique([teachingAssignmentId, meetingNumber])
  @@index([teachingAssignmentId, meetingDate])
  @@index([meetingDate])
}

model GradingComponent {
  id                     String             @id @default(uuid()) @db.Uuid
  subjectId              String             @map("subject_id") @db.Uuid
  academicYearId         String             @map("academic_year_id") @db.Uuid
  semesterId             String             @map("semester_id") @db.Uuid
  name                   String             @db.VarChar(50)
  weight                 Decimal            @db.Decimal(3, 2)
  assessmentCategory     AssessmentCategory @map("assessment_category")
  assessmentTypeDetail   AssessmentTypeDetail @map("assessment_type_detail")
  description            String?            @db.Text
  isActive               Boolean            @default(true) @map("is_active")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  deletedAt              DateTime?          @map("deleted_at")

  subject               Subject        @relation(fields: [subjectId], references: [id])
  academicYear          AcademicYear   @relation(fields: [academicYearId], references: [id])
  semester              Semester       @relation(fields: [semesterId], references: [id])
  summativeAssessments  SummativeAssessment[]

  @@map("grading_components")
  @@unique([academicYearId, semesterId, subjectId, name])
  @@index([academicYearId, semesterId])
  @@index([subjectId])
}

model FormativeAssessment {
  id                   String            @id @default(uuid()) @db.Uuid
  learningObjectiveId  String            @map("learning_objective_id") @db.Uuid
  meetingId            String            @map("meeting_id") @db.Uuid
  teachingAssignmentId String            @map("teaching_assignment_id") @db.Uuid
  studentId            String            @map("student_id") @db.Uuid
  score                Decimal           @db.Decimal(5, 2)
  maxScore             Decimal           @map("max_score") @db.Decimal(5, 2)
  feedback             String?           @db.Text
  assessmentDate       DateTime          @map("assessment_date") @db.Date
  assessmentType       AssessmentTypeDetail @map("assessment_type")
  recordedById         String            @map("recorded_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  learningObjective  LearningObjective @relation(fields: [learningObjectiveId], references: [id])
  meeting            Meeting           @relation(fields: [meetingId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  student            Student           @relation(fields: [studentId], references: [id])
  recorder           User              @relation("FormativeRecorder", fields: [recordedById], references: [id])

  @@map("formative_assessments")
  @@unique([learningObjectiveId, studentId, assessmentDate])
  @@index([learningObjectiveId])
  @@index([meetingId])
  @@index([studentId])
}

model SummativeAssessment {
  id                     String   @id @default(uuid()) @db.Uuid
  curriculumModuleId     String   @map("curriculum_module_id") @db.Uuid
  gradingComponentId     String   @map("grading_component_id") @db.Uuid
  meetingId              String?  @map("meeting_id") @db.Uuid
  teachingAssignmentId   String   @map("teaching_assignment_id") @db.Uuid
  studentId              String   @map("student_id") @db.Uuid
  score                  Decimal  @db.Decimal(5, 2)
  maxScore               Decimal  @map("max_score") @db.Decimal(5, 2)
  weightOverride         Decimal? @map("weight_override") @db.Decimal(3, 2)
  isPublished            Boolean  @default(false) @map("is_published")
  publishedById          String?  @map("published_by") @db.Uuid
  publishedAt            DateTime? @map("published_at")
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  curriculumModule  CurriculumModule    @relation(fields: [curriculumModuleId], references: [id])
  gradingComponent  GradingComponent    @relation(fields: [gradingComponentId], references: [id])
  meeting           Meeting?             @relation(fields: [meetingId], references: [id])
  teachingAssignment TeachingAssignment   @relation(fields: [teachingAssignmentId], references: [id])
  student           Student              @relation(fields: [studentId], references: [id])
  publishedBy       User?                @relation("PublishedBy", fields: [publishedById], references: [id])

  @@map("summative_assessments")
  @@unique([curriculumModuleId, studentId, gradingComponentId])
  @@index([curriculumModuleId])
  @@index([studentId])
  @@index([gradingComponentId])
  @@index([teachingAssignmentId])
  @@index([meetingId])
}

model GradeDashboard {
  id                       String    @id @default(uuid()) @db.Uuid
  studentId                String    @map("student_id") @db.Uuid
  teachingAssignmentId     String    @map("teaching_assignment_id") @db.Uuid
  subjectId                String    @map("subject_id") @db.Uuid
  semesterId               String    @map("semester_id") @db.Uuid
  academicYearId           String    @map("academic_year_id") @db.Uuid
  numericScore             Decimal   @map("numeric_score") @db.Decimal(5, 2)
  letterGrade              GradeLetter @map("letter_grade")
  predicate                Predicate  @map("predicate")
  isPublished              Boolean   @default(false) @map("is_published")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  student           Student           @relation(fields: [studentId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  subject           Subject           @relation(fields: [subjectId], references: [id])
  semester          Semester          @relation(fields: [semesterId], references: [id])
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])

  @@map("grades_dashboard")
  @@unique([studentId, semesterId, academicYearId])
  @@index([teachingAssignmentId, studentId])
  @@index([studentId, semesterId])
}

model Raport {
  id                   String    @id @default(uuid()) @db.Uuid
  studentId            String    @map("student_id") @db.Uuid
  teachingAssignmentId String    @map("teaching_assignment_id") @db.Uuid
  subjectId            String    @map("subject_id") @db.Uuid
  semesterId           String    @map("semester_id") @db.Uuid
  academicYearId       String    @map("academic_year_id") @db.Uuid
  numericScore         Decimal   @map("numeric_score") @db.Decimal(5, 2)
  letterGrade          GradeLetter @map("letter_grade")
  predicate            Predicate  @map("predicate")
  attendanceSummary    String?   @map("attendance_summary") @db.Json
  teacherNote          String?   @map("teacher_note") @db.Text
  parentNote           String?   @map("parent_note") @db.Text
  isPrinted            Boolean   @default(false) @map("is_printed")
  printedAt            DateTime? @map("printed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  student           Student           @relation(fields: [studentId], references: [id])
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  subject           Subject           @relation(fields: [subjectId], references: [id])
  semester          Semester          @relation(fields: [semesterId], references: [id])
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])

  @@map("raport")
  @@unique([studentId, semesterId, academicYearId])
  @@index([studentId, semesterId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  tableName String   @map("table_name") @db.VarChar(50)
  recordId  String   @map("record_id") @db.VarChar(100)
  oldValues String?  @map("old_values") @db.Json
  newValues String?  @map("new_values") @db.Json
  ipAddress String   @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([tableName])
}